# ------------------------------------------------------------------
# Copy this file to .env and fill in your MySQL credentials.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ------------------------------------------------------------------

# Port of the Express server (frontend + API)
PORT=3000

# MySQL connection (used by the Python engine and migrate.py)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=item_purchase_db

# Cloud databases (TiDB Cloud, PlanetScale, Aiven, RDS ...) ------------------
# Encrypt the connection: auto (default: on for known cloud hosts) | true | false
DB_SSL=auto
# Optional CA certificate file (absolute or relative to the project folder).
# Leave empty to use the operating system's trusted certificates.
DB_SSL_CA=
# Optional single connection string. When set it WINS over DB_HOST/DB_PORT/
# DB_USER/DB_PASSWORD/DB_NAME. URL-encode special characters in the password.
#   DATABASE_URL=mysql://user:password@host:4000/lumen_store?ssl=true
DATABASE_URL=
# Seconds to wait for the database to accept a connection
DB_CONNECT_TIMEOUT=10

# Python executable used to start the processing engine.
# Leave empty for the default (python on Windows, python3 elsewhere).
# Examples: PYTHON_PATH=py   or   PYTHON_PATH=C:\Python312\python.exe
PYTHON_PATH=

# Items with stock 1..LOW_STOCK_THRESHOLD are shown as "Low Stock"
LOW_STOCK_THRESHOLD=5

# Python engine worker threads (each has its own MySQL connection)
ENGINE_THREADS=4

# Max time (ms) Express waits for the engine before returning 504
ENGINE_TIMEOUT_MS=15000
